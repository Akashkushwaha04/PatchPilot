# PatchPilot AI configuration. Copy to backend/.env or export in your shell.
# These values are read by the backend only; nothing here reaches the browser.

# AI explanations: "anthropic", "openai" (any OpenAI-compatible API) or "none".
# With "none" (the default), built-in deterministic explanations are used.
PATCHPILOT_AI_PROVIDER=none
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional model override (defaults: claude-sonnet-5-5 / gpt-4o-mini)
PATCHPILOT_AI_MODEL=

# Deployed-URL scanning of public, browser-visible assets. 1 = on, 0 = off.
PATCHPILOT_URL_SCAN=1

# SQLite file for scan history (default: backend/data/patchpilot.db)
PATCHPILOT_DB=

# Extra origins allowed to call the API (only needed for the Vite dev server)
PATCHPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
